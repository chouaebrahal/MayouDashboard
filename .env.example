# Firebase Admin SDK (SECRET - server only)
# Paste the private key on ONE line, keeping the \n sequences.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Protects the daily cron endpoint (Vercel sends it automatically)
CRON_SECRET=
